{
  "name": "seal",
  "version": "0.1.0",
  "description": "Evidence-backed document assembly system",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 tests/**/*.test.ts",
    "test:golden": "tsx --test tests/golden-template.integration.ts",
    "verify": "npm run typecheck && npm run test",
    "build:dsh": "node scripts/build-dsh-bundle.mjs",
    "build:market": "node scripts/build-market-index.mjs",
    "dsh:doctor": "node scripts/dsh-doctor.mjs",
    "dsh:fix": "node scripts/dsh-doctor.mjs --fix"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^3.0.0",
    "bmp-ts": "^1.0.9",
    "jpeg-js": "^0.4.4",
    "marked": "^15.0.12",
    "saxes": "6.0.0",
    "sharp": "^0.35.5"
  }
}
